{
  "_comment": "Template tham khảo. Copy giá trị thật vào User Secrets (dotnet user-secrets) hoặc biến môi trường, KHÔNG commit secret thật vào file appsettings.json.",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=WaterbusDb;User Id=sa;Password=YOUR_STRONG_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "RedisConnection": "localhost:6379"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_RANDOM_256BIT_SECRET",
    "Issuer": "WaterbusSystemApi",
    "Audience": "WaterbusClients",
    "ExpiryMinutes": 1440
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "VnPay": {
    "TmnCode": "YOUR_VNPAY_SANDBOX_TMNCODE",
    "HashSecret": "YOUR_VNPAY_SANDBOX_HASH_SECRET",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "WebApiUrl": "https://sandbox.vnpayment.vn/merchant_webapi/api/transaction",
    "ReturnUrl": "http://localhost:5173/payment/callback",
    "Version": "2.1.0"
  },
  "Checkout": {
    "_comment": "BR-HOLD-02/BR-HOLD-05: TTL của phiên giữ ghế KHÔNG được kéo dài khi thêm/bớt ghế; tính từ lần giữ hợp lệ đầu tiên. BR-HOLD-03: cửa sổ PaymentPending riêng để chờ gateway xác nhận.",
    "SessionTtlMinutes": 10,
    "PaymentPendingTtlMinutes": 15
  },
  "Tracking": {
    "PersistIntervalSeconds": 15,
    "MaxPositionAgeMinutes": 60,
    "Simulator": {
      "Enabled": false,
      "IntervalSeconds": 3,
      "IncludeScheduledTrips": false
    }
  },
  "Weather": {
    "Enabled": true,
    "Provider": "Fake",
    "ApiKey": "YOUR_OPENWEATHERMAP_API_KEY",
    "BaseUrl": "https://api.openweathermap.org/data/2.5/",
    "CronExpression": "*/15 * * * *",
    "LookaheadHours": 3,
    "WindSpeedThresholdMs": 10.6,
    "GustThresholdMs": 17.2,
    "AlertWindowHours": 3,
    "TimeoutSeconds": 10,
    "MaxRetries": 2,
    "Fake": {
      "WindSpeedMs": 3,
      "WindGustMs": null,
      "ConditionCode": 800,
      "Description": "trời quang"
    }
  },
  "Hangfire": {
    "Dashboard": {
      "Username": "",
      "Password": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
