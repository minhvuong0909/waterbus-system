{
  "_comment": "Template tham khảo. Copy giá trị thật vào User Secrets (dotnet user-secrets) hoặc biến môi trường, KHÔNG commit secret thật vào file appsettings.json.",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=WaterbusDb;User Id=sa;Password=YOUR_STRONG_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "RedisConnection": "localhost:6379"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_RANDOM_256BIT_SECRET",
    "Issuer": "WaterbusSystemApi",
    "Audience": "WaterbusClients",
    "ExpiryMinutes": 1440
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "VnPay": {
    "TmnCode": "YOUR_VNPAY_SANDBOX_TMNCODE",
    "HashSecret": "YOUR_VNPAY_SANDBOX_HASH_SECRET",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "WebApiUrl": "https://sandbox.vnpayment.vn/merchant_webapi/api/transaction",
    "ReturnUrl": "http://localhost:5173/payment/callback",
    "Version": "2.1.0"
  },
  "Checkout": {
    "_comment": "BR-HOLD-02/BR-HOLD-05: TTL của phiên giữ ghế KHÔNG được kéo dài khi thêm/bớt ghế; tính từ lần giữ hợp lệ đầu tiên. BR-HOLD-03: cửa sổ PaymentPending riêng để chờ gateway xác nhận.",
    "SessionTtlMinutes": 10,
    "PaymentPendingTtlMinutes": 15,
    "AccessTokenTtlDays": 30
  },
  "Qr": {
    "KeyId": "waterbus-booking-v1",
    "PrivateKeyPem": "",
    "_comment": "RSA >=2048 bit. Supply PrivateKeyPem via User Secrets or environment; never commit an actual key."
  },
  "CheckIn": {
    "NoShowFinalization": {
      "_comment": "BR-BOARD-05/BR-OFF-04: chỉ kết luận NoShow sau khi cửa sổ check-in của bến lên đóng và chờ thêm GraceMinutes để sự kiện offline kịp đồng bộ.",
      "Enabled": true,
      "CronExpression": "*/5 * * * *",
      "GraceMinutes": 15
    }
  },
  "RedisLock": {
    "_comment": "Optional Connections array: independent Redis instances. Omit to use ConnectionStrings:RedisConnection."
  },
  "AzureSpeech": {
    "SubscriptionKey": "SET_IN_USER_SECRETS_OR_ENVIRONMENT",
    "Region": "YOUR_SPEECH_RESOURCE_REGION",
    "DefaultVoiceName": "YOUR_VI_VN_NEURAL_VOICE",
    "OutputFormat": "Audio16Khz32KBitRateMonoMp3",
    "TimeoutSeconds": 60
  },
  "AzureBlobAudioStorage": {
    "ConnectionString": "SET_IN_USER_SECRETS_OR_ENVIRONMENT",
    "ContainerName": "audio-guides-private"
  },
  "SightseeingAudio": {
    "_comment": "Local demo only. LogOnly dispatcher has no onboard-player ACK; keep disabled in production.",
    "EnableGpsTriggerEvaluation": false
  },
  "AiBookingAssistant": {
    "Integration": {
      "IsTripSearchContractVerified": false,
      "IsBookingLinkContractVerified": false,
      "BookingUrlTemplate": null
    },
    "Groq": {
      "ApiKey": "SET_IN_USER_SECRETS_OR_ENVIRONMENT",
      "ModelId": "openai/gpt-oss-20b",
      "IsEnabled": false,
      "MaxToolCallsPerTurn": 5,
      "TimeoutSeconds": 30
    }
  },
  "Tracking": {
    "PersistIntervalSeconds": 15,
    "MaxPositionAgeMinutes": 60,
    "Simulator": {
      "Enabled": false,
      "IntervalSeconds": 3,
      "IncludeScheduledTrips": false
    }
  },
  "Weather": {
    "Enabled": true,
    "Provider": "Fake",
    "ApiKey": "YOUR_OPENWEATHERMAP_API_KEY",
    "BaseUrl": "https://api.openweathermap.org/data/2.5/",
    "CronExpression": "*/15 * * * *",
    "LookaheadHours": 3,
    "WindSpeedThresholdMs": 10.6,
    "GustThresholdMs": 17.2,
    "AlertWindowHours": 3,
    "TimeoutSeconds": 10,
    "MaxRetries": 2,
    "Fake": {
      "WindSpeedMs": 3,
      "WindGustMs": null,
      "ConditionCode": 800,
      "Description": "trời quang"
    }
  },
  "Hangfire": {
    "Dashboard": {
      "Username": "",
      "Password": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
