<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phụ thuộc một chiều vào Domain -->
    <ProjectReference Include="..\WaterbusSystem.Domain\WaterbusSystem.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kiểm tra tính hợp lệ dữ liệu đầu vào -->
    <PackageReference Include="FluentValidation" Version="11.10.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.10.0" />
    <!-- Abstraction thuần (không phải EF Core/MediatR) dùng bởi Service: ILogger<T>, IOptions<T> -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

</Project>
