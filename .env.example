# Sao chép thành .env (KHÔNG commit). Dùng cho `docker compose` ở thư mục gốc.

# SQL Server: >= 8 ký tự, có chữ hoa, chữ thường, số/ký tự đặc biệt.
# Tránh ký tự ; hoặc ' vì mật khẩu được nhúng vào connection string.
MSSQL_SA_PASSWORD=ChangeMe_Strong123
REDIS_PASSWORD=ChangeMe_Redis123

# Khoá ký JWT, >= 32 ký tự ngẫu nhiên (vd: openssl rand -base64 48)
JWT_SECRET=

# URL công khai của Web (dùng cho CORS và VNPay return URL)
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Production = tắt Swagger VÀ KHÔNG nạp dữ liệu mẫu (không có tài khoản Admin/Captain/Staff, không có tuyến/chuyến).
# Chạy local để demo: đặt Development (bật Swagger và nạp dữ liệu mẫu khi khởi động).
ASPNETCORE_ENVIRONMENT=Production
API_HOST_PORT=5000

# VNPay sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# API truy vấn/hoàn tiền: phải đổi CÙNG LÚC với VNPAY_BASE_URL khi chuyển sang production.
VNPAY_WEBAPI_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Theo dõi vị trí tàu
TRACKING_PERSIST_INTERVAL_SECONDS=15
# Giả lập GPS theo Route cho demo (BR-TRK-01). INCLUDE_SCHEDULED=true: giả lập cả Trip chưa chạy.
TRACKING_SIMULATOR_ENABLED=false
TRACKING_SIMULATOR_INTERVAL_SECONDS=3
TRACKING_SIMULATOR_INCLUDE_SCHEDULED=false

# Weather Guard (Hangfire, mặc định mỗi 15 phút). PROVIDER: Fake (demo, không cần key) | OpenWeatherMap
WEATHER_ENABLED=true
WEATHER_PROVIDER=Fake
OPENWEATHERMAP_API_KEY=

# Phần AI của Thịnh. Chỉ điền trong .env local (không commit).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=
AZURE_SPEECH_OUTPUT_FORMAT=Audio16Khz32KBitRateMonoMp3
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_AUDIO_CONTAINER=audio-guides-private
# Chỉ bật local demo để ghi log GPS → POI; chưa có loa tàu/ACK thật.
SIGHTSEEING_AUDIO_ENABLE_GPS_TRIGGER_EVALUATION=false
GROQ_API_KEY=
AI_BOOKING_ENABLED=false
AI_TRIP_SEARCH_CONTRACT_VERIFIED=false
AI_UNVERIFIED_TRIP_CARDS_DEV=false
AI_BOOKING_LINK_CONTRACT_VERIFIED=false
# Chỉ điền template HTTPS có đúng một {tripId} sau khi owner Web/Booking xác nhận.
AI_BOOKING_URL_TEMPLATE=
WEATHER_CRON=*/15 * * * *
WEATHER_LOOKAHEAD_HOURS=3
# Ngưỡng m/s: 10.6 ≈ 38 km/h (gió trung bình -> Medium); 17.2 ≈ cấp 8 (gió giật -> High). Dông (mã 2xx) -> High.
WEATHER_WIND_THRESHOLD_MS=10.6
WEATHER_GUST_THRESHOLD_MS=17.2
# Chỉ dùng khi PROVIDER=Fake. Đặt WIND_MS=15 hoặc CONDITION_CODE=211 để demo cảnh báo.
WEATHER_FAKE_WIND_MS=3
WEATHER_FAKE_GUST_MS=
WEATHER_FAKE_CONDITION_CODE=800

# Dashboard /hangfire (Basic Auth). Để trống: chỉ mở khi ASPNETCORE_ENVIRONMENT=Development.
HANGFIRE_DASHBOARD_USER=
HANGFIRE_DASHBOARD_PASSWORD=

# Cổng mở ra máy host (đổi nếu bị trùng)
SQLSERVER_HOST_PORT=1433
REDIS_HOST_PORT=6379

# TV2 commercial settings for direct .NET hosting; inject into API environment when deploying.
Checkout__SessionTtlMinutes=10
Checkout__PaymentPendingTtlMinutes=15
Checkout__AccessTokenTtlDays=30
Qr__KeyId=waterbus-booking-v1
# Multiline PEM from a secure secret store. Never commit an actual key.
Qr__PrivateKeyPem=
# Optional independent RedLock connections, e.g. RedisLock__Connections__0=redis1:6379
# (Compose KHÔNG chuyển biến RedisLock__*: một giá trị rỗng sẽ làm hỏng cấu hình. Cần thì thêm vào docker-compose.override.yml.)
NOSHOW_FINALIZATION_ENABLED=true
NOSHOW_FINALIZATION_CRON=*/5 * * * *
NOSHOW_FINALIZATION_GRACE_MINUTES=15
