# Sao chép thành .env (KHÔNG commit). Dùng cho `docker compose` ở thư mục gốc.

# SQL Server: >= 8 ký tự, có chữ hoa, chữ thường, số/ký tự đặc biệt.
# Tránh ký tự ; hoặc ' vì mật khẩu được nhúng vào connection string.
MSSQL_SA_PASSWORD=ChangeMe_Strong123
REDIS_PASSWORD=ChangeMe_Redis123

# Khoá ký JWT, >= 32 ký tự ngẫu nhiên (vd: openssl rand -base64 48)
JWT_SECRET=

# URL công khai của Web (dùng cho CORS và VNPay return URL)
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Production = tắt Swagger. Đặt Development để bật Swagger (chỉ dùng khi chạy local).
ASPNETCORE_ENVIRONMENT=Production
API_HOST_PORT=5000

# VNPay sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Theo dõi vị trí tàu
TRACKING_PERSIST_INTERVAL_SECONDS=15
# Giả lập GPS theo Route cho demo (BR-TRK-01). INCLUDE_SCHEDULED=true: giả lập cả Trip chưa chạy.
TRACKING_SIMULATOR_ENABLED=false
TRACKING_SIMULATOR_INTERVAL_SECONDS=3
TRACKING_SIMULATOR_INCLUDE_SCHEDULED=false

# Weather Guard (Hangfire, mặc định mỗi 15 phút). PROVIDER: Fake (demo, không cần key) | OpenWeatherMap
WEATHER_ENABLED=true
WEATHER_PROVIDER=Fake
OPENWEATHERMAP_API_KEY=
WEATHER_CRON=*/15 * * * *
WEATHER_LOOKAHEAD_HOURS=3
# Ngưỡng m/s: 10.6 ≈ 38 km/h (gió trung bình -> Medium); 17.2 ≈ cấp 8 (gió giật -> High). Dông (mã 2xx) -> High.
WEATHER_WIND_THRESHOLD_MS=10.6
WEATHER_GUST_THRESHOLD_MS=17.2
# Chỉ dùng khi PROVIDER=Fake. Đặt WIND_MS=15 hoặc CONDITION_CODE=211 để demo cảnh báo.
WEATHER_FAKE_WIND_MS=3
WEATHER_FAKE_GUST_MS=
WEATHER_FAKE_CONDITION_CODE=800

# Dashboard /hangfire (Basic Auth). Để trống: chỉ mở khi ASPNETCORE_ENVIRONMENT=Development.
HANGFIRE_DASHBOARD_USER=
HANGFIRE_DASHBOARD_PASSWORD=

# Cổng mở ra máy host (đổi nếu bị trùng)
SQLSERVER_HOST_PORT=1433
REDIS_HOST_PORT=6379
