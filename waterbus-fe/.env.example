# Copy this file to `.env.local` (git-ignored) and adjust.

# Base URL of waterbus-be (WaterbusSystem.WebApi). No trailing slash.
VITE_API_BASE_URL=http://localhost:5000

# true  -> every service returns mock data, no backend needed.
# false -> services whose endpoint already exists in the backend call it for real;
#          the rest (no endpoint yet) still return mock data.
VITE_USE_MOCK=false
