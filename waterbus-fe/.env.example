# Copy this file to `.env.local` (git-ignored) and adjust.

# Base URL of waterbus-be (WaterbusSystem.WebApi). No trailing slash.
VITE_API_BASE_URL=

# Map tiles of the pier maps. Optional: the default is Esri's topographic map (no key needed).
# VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
# VITE_MAP_TILE_ATTRIBUTION=Tiles &copy; Esri
